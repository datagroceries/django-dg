#: apps.py:8 conf.py:10 mcp.py:11
msgid "Wiki"
msgstr "Wiki"

#: forms.py:25
msgid "At the top"
msgstr "Bovenaan"

#: forms.py:26
msgid "Under"
msgstr "Onder"

#: forms.py:40 templates/gilde_wiki/page_edit.html:16
msgid "Title"
msgstr "Titel"

#: models.py:62
msgid "under"
msgstr "onder"

#: models.py:65
msgid "title"
msgstr "titel"

#: models.py:72
msgid "text"
msgstr "tekst"

#: models.py:72
msgid "Markdown."
msgstr "Markdown."

#: models.py:114
msgid "A page cannot go under itself or a page under it."
msgstr "Een pagina kan niet onder zichzelf of onder een pagina eronder."

#: models.py:118
msgid ""
"This page would be too deep in the tree, or its title too long, for an "
"address."
msgstr ""
"Deze pagina komt te diep in de boom, of haar titel is te lang, voor een "
"adres."

#: operations.py:43 templates/gilde_wiki/page.html:20
msgid "Move or delete the pages under this page first."
msgstr "Verplaats of verwijder eerst de pagina's onder deze pagina."

#: templates/gilde_wiki/_new_page_form.html:14
msgid "Create and write"
msgstr "Maken en schrijven"

#: templates/gilde_wiki/_tree.html:1
msgid "No pages yet."
msgstr "Nog geen pagina's."

#: templates/gilde_wiki/_wiki.html:16
msgid "Pages"
msgstr "Pagina's"

#: templates/gilde_wiki/_wiki.html:19 templates/gilde_wiki/home.html:17
#: templates/gilde_wiki/page_create.html:4
#: templates/gilde_wiki/page_create.html:8
msgid "New page"
msgstr "Nieuwe pagina"

#: templates/gilde_wiki/home.html:4
msgid "Start"
msgstr "Start"

#: templates/gilde_wiki/home.html:9
msgid "Recently changed"
msgstr "Onlangs gewijzigd"

#: templates/gilde_wiki/home.html:16
msgid ""
"The wiki is empty. Start with a page about what the team knows and others "
"should too."
msgstr ""
"De wiki is leeg. Begin met een pagina over wat het team weet en anderen ook "
"zouden moeten weten."

#: templates/gilde_wiki/missing.html:4
msgid "No such page"
msgstr "Pagina bestaat niet"

#: templates/gilde_wiki/missing.html:8
msgid "No such page yet"
msgstr "Deze pagina bestaat nog niet"

#: templates/gilde_wiki/missing.html:9
#, python-format
msgid "No page has the address <code>%(path)s</code>. Start it?"
msgstr "Geen pagina heeft het adres <code>%(path)s</code>. Beginnen?"

#: templates/gilde_wiki/page.html:11
msgid "Edit"
msgstr "Bewerken"

#: templates/gilde_wiki/page.html:13
msgid "More"
msgstr "Meer"

#: templates/gilde_wiki/page.html:15
msgid "New page under this one"
msgstr "Nieuwe pagina hieronder"

#: templates/gilde_wiki/page.html:16 templates/gilde_wiki/page_move.html:19
msgid "Move"
msgstr "Verplaatsen"

#: templates/gilde_wiki/page.html:20 templates/gilde_wiki/page.html:24
msgid "Delete"
msgstr "Verwijderen"

#: templates/gilde_wiki/page.html:23
msgid "Delete this page? Its history stays."
msgstr "Deze pagina verwijderen? Haar geschiedenis blijft bewaard."

#: templates/gilde_wiki/page.html:34
#, python-format
msgid "Last changed by %(person)s, %(when)s"
msgstr "Laatst gewijzigd door %(person)s, %(when)s"

#: templates/gilde_wiki/page.html:40
msgid "This page is empty."
msgstr "Deze pagina is leeg."

#: templates/gilde_wiki/page.html:40
msgid "Write it"
msgstr "Begin met schrijven"

#: templates/gilde_wiki/page.html:44
msgid "On this page"
msgstr "Op deze pagina"

#: templates/gilde_wiki/page.html:52
msgid "Pages under this one"
msgstr "Pagina's hieronder"

#: templates/gilde_wiki/page_edit.html:4
#, python-format
msgid "Editing %(title)s"
msgstr "%(title)s bewerken"

#: templates/gilde_wiki/page_edit.html:20
msgid "Save"
msgstr "Opslaan"

#: templates/gilde_wiki/page_edit.html:21
#: templates/gilde_wiki/page_move.html:20
msgid "Cancel"
msgstr "Annuleren"

#: templates/gilde_wiki/page_move.html:4
#, python-format
msgid "Moving %(title)s"
msgstr "%(title)s verplaatsen"

#: templates/gilde_wiki/page_move.html:8
#, python-format
msgid "Move “%(title)s”"
msgstr "“%(title)s” verplaatsen"

#: templates/gilde_wiki/page_move.html:16
msgid "The pages under it go with it. Its old address keeps leading here."
msgstr "De pagina's eronder gaan mee. Het oude adres blijft hierheen leiden."

#: views.py:31
msgid "Someone"
msgstr "Iemand"

#: views.py:37
#, python-format
msgid "via %(name)s"
msgstr "via %(name)s"

#: views.py:106
#, python-format
msgid ""
"%(who)s saved this page while you were editing it. Your text is still here: "
"open the page in another tab to see theirs, put the two together, and save "
"again to replace theirs."
msgstr ""
"%(who)s sloeg deze pagina op terwijl jij haar bewerkte. Je tekst staat er "
"nog: open de pagina in een ander tabblad om die van hen te zien, voeg de "
"twee samen en sla opnieuw op om die van hen te vervangen."

#: views.py:136
#, python-format
msgid "“%(title)s” is deleted."
msgstr "“%(title)s” is verwijderd."
