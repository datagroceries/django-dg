msgstr "via %(name)s"

#: versions.py:36
msgid "Created"
msgstr "Gemaakt"

#: versions.py:39
#, python-format
msgid "Brought back the version of %(when)s"
msgstr "De versie van %(when)s teruggezet"

#: versions.py:42
#, python-format
