msgstr "%(title)s bewerken"

#: templates/dg_wiki/page_history.html:4
#, python-format
msgid "History of %(title)s"
msgstr "Geschiedenis van %(title)s"

#: templates/dg_wiki/page_history.html:8
#, python-format
msgid "History of “%(title)s”"
msgstr "Geschiedenis van “%(title)s”"

#: templates/dg_wiki/page_history.html:19
msgid "Compare with the version before"
msgstr "Vergelijken met de versie ervoor"

#: templates/dg_wiki/page_history.html:20
msgid "Compare with now"
msgstr "Vergelijken met nu"

#: templates/dg_wiki/page_move.html:4
#, python-format
msgid "Moving %(title)s"
msgstr "%(title)s verplaatsen"

#: templates/dg_wiki/page_move.html:8
#, python-format
msgid "Move “%(title)s”"
msgstr "“%(title)s” verplaatsen"

#: templates/dg_wiki/page_move.html:16
msgid "The pages under it go with it. Its old address keeps leading here."
msgstr "De pagina's eronder gaan mee. Het oude adres blijft hierheen leiden."

#: templates/dg_wiki/page_translate.html:4
#, python-format
msgid "Translating %(title)s"
msgstr "%(title)s vertalen"

#: templates/dg_wiki/page_translate.html:8
#, python-format
msgid "Translate “%(title)s”"
msgstr "“%(title)s” vertalen"

#: templates/dg_wiki/page_translate.html:20
msgid ""
"The translation goes beside this page, and opens in the editor with this "
"page's text, to translate."
msgstr ""
"De vertaling komt naast deze pagina, en opent in de editor met de tekst van "
"deze pagina, om te vertalen."

#: templates/dg_wiki/search.html:4
#, python-format
msgid "“%(query)s”"
msgstr "“%(query)s”"

#: templates/dg_wiki/search.html:4 templates/dg_wiki/search.html:8
msgid "Search"
msgstr "Zoeken"

#: templates/dg_wiki/search.html:8
#, python-format
msgid "Pages with “%(query)s”"
msgstr "Pagina's met “%(query)s”"

#: templates/dg_wiki/search.html:20
#, python-format
msgid "The first %(most)s pages. Add a word to find fewer."
msgstr ""
"De eerste %(most)s pagina's. Voeg een woord toe om er minder te vinden."

#: templates/dg_wiki/search.html:22
msgid "No page holds all these words."
msgstr "Geen pagina bevat al deze woorden."

#: templates/dg_wiki/search.html:25
msgid ""
"Type words in the box above the pages: the pages that hold all of them show "
"here."
msgstr ""
"Typ woorden in het vak boven de pagina's: de pagina's die ze allemaal "
"bevatten, staan dan hier."

#: versions.py:20
msgid "Someone"
msgstr "Iemand"

#: versions.py:26
#, python-format
