msgstr "Tekst gewijzigd"

#: versions.py:47
#, python-format
msgid "Moved under “%(title)s”"
msgstr "Verplaatst naar onder “%(title)s”"

#: versions.py:47
msgid "Moved to the top"
msgstr "Naar boven verplaatst"

#: views.py:165
#, python-format
msgid ""
"%(who)s saved this page while you were editing it. Your text is still here: "
"open the page in another tab to see theirs, put the two together, and save "
"again to replace theirs."
msgstr ""
"%(who)s sloeg deze pagina op terwijl jij haar bewerkte. Je tekst staat er "
"nog: open de pagina in een ander tabblad om die van hen te zien, voeg de "
"twee samen en sla opnieuw op om die van hen te vervangen."

#: views.py:196
#, python-format
msgid "“%(title)s” is deleted."
msgstr "“%(title)s” is verwijderd."

#: views.py:277
#, python-format
msgid "The version of %(when)s is back."
msgstr "De versie van %(when)s is teruggezet."

#: views.py:298
#, python-format
msgid "%(name)s is larger than %(size)s MB."
msgstr "%(name)s is groter dan %(size)s MB."

#: views.py:331
msgid "A comment needs text."
msgstr "Een reactie heeft tekst nodig."

#: views.py:347
msgid "A comment needs text; the old one is kept."
msgstr "Een reactie heeft tekst nodig; de oude blijft staan."
