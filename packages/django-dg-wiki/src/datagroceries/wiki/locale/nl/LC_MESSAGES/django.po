msgstr "Laatst gewijzigd door %(person)s, %(when)s"

#: templates/dg_wiki/page.html:81
msgid "Write an introduction"
msgstr "Schrijf een inleiding"

#: templates/dg_wiki/page.html:83
msgid "This page is empty."
msgstr "Deze pagina is leeg."

#: templates/dg_wiki/page.html:83
msgid "Write it"
msgstr "Begin met schrijven"

#: templates/dg_wiki/page.html:88
