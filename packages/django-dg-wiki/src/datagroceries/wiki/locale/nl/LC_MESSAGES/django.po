msgstr "Bestanden"

#: templates/dg_wiki/page.html:108
msgid "Add a file"
msgstr "Bestand toevoegen"

#: templates/dg_wiki/page.html:112
msgid "File"
msgstr "Bestand"

#: templates/dg_wiki/page.html:113
msgid "Upload"
msgstr "Uploaden"

#: templates/dg_wiki/page_compare.html:4
#, python-format
msgid "Versions of %(title)s"
msgstr "Versies van %(title)s"

#: templates/dg_wiki/page_compare.html:9
#, python-format
msgid "Versions of “%(title)s”"
msgstr "Versies van “%(title)s”"

#: templates/dg_wiki/page_compare.html:10
msgid "All versions"
msgstr "Alle versies"

#: templates/dg_wiki/page_compare.html:26
#, python-format
msgid "%(lines)s line unchanged"
msgid_plural "%(lines)s lines unchanged"
msgstr[0] "%(lines)s regel ongewijzigd"
msgstr[1] "%(lines)s regels ongewijzigd"

#: templates/dg_wiki/page_compare.html:34
msgid "The text is the same."
msgstr "De tekst is hetzelfde."

#: templates/dg_wiki/page_edit.html:4
#, python-format
