# The nightly dump of DataGroceries' database; copied to /etc/systemd/system/, run by gilde-backup.timer.
# Kept 14 days in /srv/gilde/backups. It guards against mistakes, not against losing the server.
[Unit]
Description=Dump DataGroceries' database
After=postgresql.service

[Service]
Type=oneshot
User=gilde
Group=gilde
# The dumps are for the gilde user alone.
UMask=0077
ExecStart=/bin/sh -c 'pg_dump --format=custom datagroceries > /srv/gilde/backups/dg-$(date +%%F).dump'
ExecStart=/usr/bin/find /srv/gilde/backups -name 'dg-*.dump' -mtime +14 -delete
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/gilde/backups
