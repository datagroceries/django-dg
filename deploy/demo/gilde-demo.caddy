# Gilde's public demo on web1; copied to /etc/caddy/sites/gilde-demo.caddy. Source: the Gilde repository,
# deploy/demo/.
demo.gildehq.com {
	# Uploads up to 5 MB: the board allows 20, but this is a public server with a small disk.
	request_body {
		max_size 5MB
	}
	handle_path /static/* {
		root * /srv/gilde-demo/static
		file_server
	}
	reverse_proxy 127.0.0.1:8003
}
